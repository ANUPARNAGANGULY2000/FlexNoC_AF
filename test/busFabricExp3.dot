digraph G{

	rankdir = "LR"
ingressQpush1 = 1
ingressQpop1 = 4
egressQpush2 = 3
egressQpop2 = 4

IP6[label="IP6", type=Source, rate=0.05, cv=0.5, t_serv=1.0, shape="rarrow"];
IP0[label="IP0", type=Source, rate=0.05, cv=0.5, t_serv=1.0, shape="rarrow"];
Temp_buffer0[label="Temp_buffer0", type=QUEUE, depth=12, latency=ingressQpush1+ingressQpop1,  shape="cylinder"];
Temp_buffer1[label="Temp_buffer1", type=QUEUE, depth=12, latency=ingressQpush1+ingressQpop1, shape="cylinder"];
BF6_arbiter[label="BF6_arbiter", type=PRioRity, zero_load=3.0, t_serv=0.0, coeff_var=0.0, shape="trapezium"];
BF0_arbiter[label="BF0_arbiter", type=PRioRity, zero_load=3.0, t_serv=0.0, coeff_var=0.0, shape="trapezium"];
BF0_SR[label="BF0_SR", type=Server, t_serv=1.0, coeff_var=0.0, shape="circle"];
BF6_SR[label="BF6_SR", type=Server, t_serv=1.0, coeff_var=0.0, shape="circle"];
BF6_buffer[label="BF6_buffer", type=Queue, depth=12, latency=egressQpush2+egressQpop2, shape="cylinder"];
BF0_buffer[label="BF0_buffer", type=Queue, depth=12, latency=egressQpush2+egressQpop2, shape="cylinder"];
DIE0_SR[label="DIE0_SR", type=Server, t_serv=1.0, coeff_var=0.0, shape="circle"];
Sink1[label="DIE0 Sink", type=Sink];

IP6 -> Temp_buffer0;
Temp_buffer0 -> BF6_arbiter;
BF6_arbiter -> BF6_SR;
BF6_SR -> BF6_buffer;
IP0 -> Temp_buffer1;
Temp_buffer1 -> BF0_arbiter;
BF6_buffer -> BF0_arbiter [pipeline_delay=15]
BF0_arbiter -> BF0_SR;
BF0_SR -> BF0_buffer
BF0_buffer -> DIE0_SR [pipeline_delay=19]
DIE0_SR -> Sink1;
}

